# Copy to .env.docker and replace every placeholder before first Docker start.
# Preserve the current APP_KEY if this installation will later import existing data.
APP_NAME="نظام مخزون السلامي والورد"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_THE_EXISTING_APP_KEY_OR_A_NEW_FRESH_INSTALL_KEY
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Africa/Tripoli
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

MYSQL_DATABASE=inventory_system
MYSQL_USER=inventory_app
MYSQL_PASSWORD=REPLACE_WITH_A_STRONG_APPLICATION_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_ROOT_DATABASE_PASSWORD

LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
